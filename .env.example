# Common Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=atomic_pay
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secret

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# JWT Security
JWT_SECRET=super_secret_jwt_key_that_is_at_least_256_bits_long_for_hmac_sha
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Service Ports
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
ACCOUNT_SERVICE_PORT=8082
TRANSACTION_SERVICE_PORT=8083
LEDGER_SERVICE_PORT=8084
NOTIFICATION_SERVICE_PORT=8085
AUDIT_SERVICE_PORT=8086
ANALYTICS_SERVICE_PORT=8087
FRONTEND_PORT=3000

# Observability Ports
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
